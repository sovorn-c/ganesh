{
  "name": "ganesh",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first research supervision assistant",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "npm run build && node dist/src/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preflight": "npm run build && node dist/src/preflight-cli.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "typescript": "5.9.2"
  }
}
